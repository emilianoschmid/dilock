@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@DILOCK_BUILD_C_API@)
    find_dependency(Threads)
endif()
find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
find_dependency(nlohmann_json 3.11 CONFIG)
find_dependency(redis++ 1.3.15 CONFIG)
if(@DILOCK_BUILD_ETCD@)
    find_dependency(OpenSSL 3.0 COMPONENTS Crypto SSL)
    find_dependency(Protobuf 3.21)
    find_dependency(gRPC 1.51 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/DilockCppTargets.cmake")
