parameters:
    level: max
    paths:
        - src
    bootstrapFiles:
        - vendor/autoload.php
    scanDirectories:
        - vendor/grpc/grpc/src/lib
        - vendor/google/protobuf/src/Google/Protobuf
    stubFiles:
        - phpstan/grpc.stub
    excludePaths:
        analyse:
            # Generated by protoc from the pinned etcd v3.7.2 schemas. The
            # generator emits dynamic protobuf fields and untyped accessors;
            # keep these files in Composer's symbol scan, but analyze the
            # handwritten adapter against the real grpc/protobuf packages.
            - src/Protocol/**
