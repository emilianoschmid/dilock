opam-version: "2.0"
name: "dilock"
version: "0.1.0"
synopsis: "Experimental Dilock Redis and etcd client"
maintainer: "Dilock contributors"
authors: "Dilock contributors"
license: "Apache-2.0"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.8"}
  "ocamlfind"
  "redis-lwt" {= "0.8"}
  "mtime" {= "2.2.0"}
  "lwt"
  "digestif"
  "yojson"
  "grpc-lwt" {= "0.2.0"}
  "h2-lwt-unix" {= "0.10.0"}
  "ocaml-protoc-plugin" {= "4.4.0"}
]
build: [ ["dune" "build" "-p" name "-j" jobs] ]
