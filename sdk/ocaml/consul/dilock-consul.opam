opam-version: "2.0"
name: "dilock-consul"
version: "0.1.0"
synopsis: "Optional Consul HTTP KV/session adapter for Dilock"
maintainer: "Dilock contributors"
authors: "Dilock contributors"
license: "Apache-2.0"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.8"}
  "dilock" {= "0.1.0"}
  "lwt"
  "cohttp-lwt-unix" {>= "5.0"}
  "uri"
  "yojson" {>= "2.0"}
  "base64"
  "mtime" {= "2.2.0"}
  "alcotest" {with-test}
]
build: [ ["dune" "build" "-p" name "-j" jobs] ]
