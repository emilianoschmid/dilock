{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "stripInternal": true,
    "outDir": "target",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
